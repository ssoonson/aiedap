rules_version = '2';
// ================================================================
// Firestore 보안 규칙 — Firebase 프로젝트 aiedap-ce609 공용
//   ① AIEDAP 모듈5 연수 웹앱 (ssoonson/aiedap)        : rooms/...
//   ② AI 창작 따라하기 (ssoonson/ai-creative-guide)    : instructors/..., creativeRooms/...
// 두 웹앱이 같은 프로젝트를 쓰므로 콘솔에는 항상 이 "합친 파일" 전체를 게시하세요.
// 한쪽 앱의 규칙만 붙여 넣으면 다른 앱의 규칙이 지워져 그 앱이 동작하지 않습니다.
// 두 저장소의 firestore.rules는 같은 내용으로 유지합니다.
//
// ※ 콘솔 > Firestore > 규칙에 붙여 넣을 때만 'teacher@example.com'을 강사 이메일로 바꾸세요.
//   저장소의 이 파일과 config.js에는 실제 이메일을 적지 마세요(누구나 볼 수 있음).
// ================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ① AIEDAP 모듈5 연수 웹앱 ----------
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'teacher@example.com';
    }

    function activityOpen(room, qid) {
      let r = /databases/$(database)/documents/rooms/$(room);
      return !exists(r) || get(r).data.get('open', {}).get(qid, true) == true;
    }

    // 문항별 응답 형식 (app.js의 validResponse와 같은 기준)
    //   q1 서술 300자 · q4/q5 서술 400자 · q6 빈칸 30자
    //   q2 { level: 1~6, strong: [A~G 1~2개], weak: [A~G 1~2개] } · q3 { level: 1~6 }
    function validValue(qid, v) {
      return (qid == 'q1' && validText(v, 300))
        || ((qid == 'q4' || qid == 'q5') && validText(v, 400))
        || (qid == 'q6' && validText(v, 30))
        || (qid == 'q2' && v is map
            && v.keys().hasOnly(['level', 'strong', 'weak'])
            && v.keys().hasAll(['level', 'strong', 'weak'])
            && validLevel(v.level) && validComps(v.strong) && validComps(v.weak))
        || (qid == 'q3' && v is map && v.keys().hasOnly(['level']) && v.keys().hasAll(['level'])
            && validLevel(v.level));
    }
    function validText(v, max) { return v is string && v.size() >= 1 && v.size() <= max; }
    function validLevel(l) { return l is int && l >= 1 && l <= 6; }
    function validComps(c) {
      return c is list && c.size() >= 1 && c.size() <= 2
        && c.hasOnly(['A', 'B', 'C', 'D', 'E', 'F', 'G']);
    }

    match /rooms/{room} {
      // 진행 상태: 누구나 읽고, 강사만 바꿈
      allow read: if request.auth != null;
      allow write: if isAdmin();

      // 별명: 참여자는 자기 별명만 정하고 바꿀 수 있음 (문서 ID = 내 uid)
      match /people/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'ts'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 12
          && request.resource.data.ts == request.time;
        allow delete: if isAdmin();
      }

      match /responses/{rid} {
        allow read: if request.auth != null;

        // 참여자는 자기 의견만 쓰고 고칠 수 있음 (문서 ID = 내 uid + '_' + 활동 ID)
        allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'qid', 'value', 'ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.qid in ['q1', 'q2', 'q3', 'q4', 'q5', 'q6']
          && rid == request.auth.uid + '_' + request.resource.data.qid
          && request.resource.data.ts == request.time
          && validValue(request.resource.data.qid, request.resource.data.value)
          && (isAdmin() || activityOpen(room, request.resource.data.qid));

        // 삭제는 강사만
        allow delete: if isAdmin();
      }
    }

    // ---------- ② AI 창작 따라하기 ----------
    // 강사 판별은 이메일이 아니라 instructors/{uid} 문서로 합니다.
    // instructors 문서는 Firebase 콘솔에서만 만들 수 있습니다(웹에서는 쓰기 금지).
    function isInstructor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/instructors/$(request.auth.uid));
    }

    // 강사 명단: 본인 문서만 읽기(강사 여부 확인용), 웹에서는 누구도 쓰지 못함
    match /instructors/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 진행 상태: 연수생은 로그인 없이 읽기만, 강사만 바꿈
    match /creativeRooms/{room} {
      allow read: if room.matches('^[a-z0-9-]{1,30}$');
      allow create, update: if isInstructor()
        && room.matches('^[a-z0-9-]{1,30}$')
        && validState(request.resource.data);
      allow delete: if isInstructor();
    }

    function validState(d) {
      return d.keys().hasOnly(['view', 'follow', 'timer', 'updatedAt'])
        && (!('view' in d) || d.view in ['start', 'image', 'music', 'story', 'news', 'wrap'])
        && (!('follow' in d) || d.follow is bool)
        && (!('timer' in d) || d.timer == null || validTimer(d.timer))
        && d.updatedAt == request.time;
    }

    function validTimer(t) {
      return t is map
        && t.keys().hasOnly(['label', 'end', 'left'])
        && t.label is string && t.label.size() <= 40
        && t.end is int
        && (t.left == null || (t.left is int && t.left >= 0 && t.left <= 7200000));
    }
  }
}
